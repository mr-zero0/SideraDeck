{
  "name": "sideradeck",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "dev:api": "wrangler pages dev dist --port 8788",
    "dev:api:ai": "wrangler pages dev dist --port 8788 --ai AI",
    "deploy": "npm run build && wrangler pages deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p functions",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:stars": "node scripts/build-starfield.mjs",
    "data:textures": "node scripts/fetch-textures.mjs",
    "data:spacecraft": "node scripts/fetch-spacecraft.mjs",
    "data:models": "node scripts/fetch-models.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "astronomy-engine": "^2.1.19",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261123.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  },
  "allowScripts": {
    "workerd@1.20261119.1": true,
    "esbuild@0.28.2": true
  }
}
